{
    "name": "gilles-g/dump-loader-bundle",
    "description": "Symfony bundle loading a SQL dump into the application database, with a live web UI.",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "gilles-g",
            "email": "ggauthier@spiriit.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "league/flysystem": "^3",
        "league/flysystem-local": "^3",
        "psr/clock": "^1.0",
        "symfony/clock": "^6.4|^7.4|^8.0",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/console": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/lock": "^6.4|^7.4|^8.0",
        "symfony/process": "^6.4|^7.4|^8.0",
        "symfony/security-csrf": "^6.4|^7.4|^8.0",
        "symfony/string": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "symfony/twig-bundle": "^6.4|^7.4|^8.0",
        "symfony/uid": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "league/flysystem-memory": "^3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "^6.4|^7.4|^8.0",
        "symfony/css-selector": "^6.4|^7.4|^8.0",
        "symfony/phpunit-bridge": "^6.4|^7.4|^8.0",
        "symfony/tui": "^8.1",
        "symfony/yaml": "^6.4|^7.4|^8.0"
    },
    "suggest": {
        "gilles-g/db-anonymizer": "To anonymize the database as a step of a dump load.",
        "league/flysystem-aws-s3-v3": "To read dumps from an S3 bucket.",
        "league/flysystem-sftp-v3": "To read dumps from an SFTP server.",
        "symfony/security-bundle": "To identify the requester of a load job.",
        "symfony/tui": "Rich terminal UI for dump-loader:load (PHP 8.4.1+, Symfony 8.1+)."
    },
    "autoload": {
        "psr-4": {
            "DumpLoader\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DumpLoader\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "check": [
            "@cs-check"
        ],
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "test": "vendor/bin/phpunit"
    }
}
