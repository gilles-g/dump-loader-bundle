<div class="grid">
    <div class="kpi">
        <span>{{ 'kpi.dumps'|trans({}, 'DumpLoaderBundle') }}</span>
        <strong>{{ dashboard.dumps|length }}</strong>
    </div>
    <div class="kpi">
        <span>{{ 'kpi.completed'|trans({}, 'DumpLoaderBundle') }}</span>
        <strong>{{ dashboard.completedCount }}</strong>
    </div>
    <div class="kpi">
        <span>{{ 'kpi.failed'|trans({}, 'DumpLoaderBundle') }}</span>
        <strong>{{ dashboard.failedCount }}</strong>
    </div>
    <div class="kpi">
        <span>{{ 'kpi.last_completed'|trans({}, 'DumpLoaderBundle') }}</span>
        <strong>{{ dashboard.lastCompletedAt ? dashboard.lastCompletedAt|date('Y-m-d H:i') : '—' }}</strong>
    </div>
</div>
